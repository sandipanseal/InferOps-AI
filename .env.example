# ──────────────────────────────────────────────────────────────────────
# InferOps AI — environment variables
# Copy to `.env` 
# ──────────────────────────────────────────────────────────────────────

# ── Local Docker Compose defaults ────────────────────────────────────
POSTGRES_DB=inferops
POSTGRES_USER=inferops
POSTGRES_PASSWORD=change_me

DATABASE_URL=postgresql+asyncpg://inferops:change_me@postgres:5432/inferops
REDIS_URL=redis://redis:6379/0

QDRANT_URL=http://qdrant:6333
RAG_COLLECTION_NAME=inferops_knowledge
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1:8b

OPENAI_API_KEY=dummy_openai_key

OLLAMA_CLOUD_BASE_URL=https://ollama.com
OLLAMA_CLOUD_API_KEY=dummy_ollama_cloud_key
OLLAMA_CLOUD_MODEL=gpt-oss:120b-cloud

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me

# ── aws-deploy / cloud overrides ─────────────────────────────────────
# Replace DATABASE_URL with the Supabase pooler string:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Replace REDIS_URL with the Upstash rediss:// string:
# REDIS_URL=rediss://default:<token>@<endpoint>.upstash.io:6380
#
# Set ENVIRONMENT so router/observability take the cloud branch:
# ENVIRONMENT=aws-deploy
#
# Langfuse (optional cloud LLM tracing):
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# AWS — populated by Terraform after apply:
AWS_REGION=eu-central-1
SQS_QUEUE_URL=

# App tuning
LOG_LEVEL=INFO
MAX_DAILY_BUDGET_USD=5.0
